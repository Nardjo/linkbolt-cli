{
  "name": "linkbolt-cli",
  "version": "0.1.0",
  "description": "CLI for the Linkbolt machine API (Capture, search, retrieve, Resource)",
  "type": "module",
  "bin": {
    "linkbolt-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "dev": "bun run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "linkbolt",
    "cli",
    "api2cli",
    "capture",
    "search",
    "retrieve"
  ]
}